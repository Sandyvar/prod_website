# Copy to .env and fill in. .env is not committed.

# Google sign-in (OAuth 2.0 "Web application" client from https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI to add in Google Cloud: <APP_URL>/api/auth/google/callback
#   dev:  http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL the browser uses. Dev default: http://localhost:5173 · production default: http://localhost:$PORT
# Use https:// in production — session cookies are then marked Secure automatically.
APP_URL=

# Optional
# PORT=3001
# DB_PATH=./data/app.db
# TRUST_PROXY=true      # behind nginx / a load balancer
# BCRYPT_ROUNDS=12
